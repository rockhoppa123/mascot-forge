# Dependencies
node_modules/
.pnpm-store/

# Playwright (e2e) artifacts
test-results/
playwright-report/
.playwright/
tests/e2e/fixtures/handoff-fixture.svg

# Build output
dist/
build/
out/
*.tsbuildinfo

# tsc -b emit artifacts from vite.config.ts (composite project)
**/vite.config.js
**/vite.config.d.ts

# Environment / secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local tooling / agent config (not part of the public repo)
.claude/
.codegraph/

# Internal working docs (council critique, strategy report, impl plan) — local only, not public
docs/internal/

# Scratch / generated artifacts (keep curated assets in assets/)
/scratch/
/tmp/
*.tmp

# Python (segmentation/tracing experiments)
__pycache__/
*.pyc
.venv/
venv/

# generated mascot output
output/

# Local test-image scratch. assets/test-images/ commits ONLY synthetic art with a generator script
# beside it ("Zero art committed; pure pixels" — see make-blip.mjs). Downloaded/third-party sources
# (emoji sets, stock art) are useful locally for playtesting the segmenter but must not be committed:
# they'd need attribution and contradict that norm. Ignore by default; un-ignore synthetic additions
# explicitly, the way blip/pip are below.
assets/test-images/*.png
!assets/test-images/blip.png
!assets/test-images/pip.png
